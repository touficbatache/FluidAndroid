<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c080d"
    android:padding="24dp"
    android:id="@+id/screen"
    tools:context=".app.FaceTimePipActivity">

    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginHorizontal="100dp"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:elegantTextHeight="true"
        android:textColor="@color/white"
        android:text="Drag and throw the yellow squircle to see how it moves." />

    <View
        android:id="@+id/screenConstraints"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/topLeftView"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="#000001"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FluidAndroid.App"
        app:strokeColor="#464247"
        app:strokeWidth="2dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/topRightView"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="#000001"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FluidAndroid.App"
        app:strokeColor="#464247"
        app:strokeWidth="2dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bottomLeftView"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="#000001"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FluidAndroid.App"
        app:strokeColor="#464247"
        app:strokeWidth="2dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bottomRightView"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="#000001"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FluidAndroid.App"
        app:strokeColor="#464247"
        app:strokeWidth="2dp" />

    <com.batache.fluidandroid.util.squircle.SquircleImageView
        android:id="@+id/pipView"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="#F2F23A"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintStart_toStartOf="parent"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>